# ==============================================================
# CSJMU CAMPUS NAVIGATOR - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================

# --- Admin Security PIN & Secrets ---
# Admin access PIN used in Admin Login modal (Default fallback is 0808)
ADMIN_PIN=0808
ADMIN_PASSWORD=0808
ADMIN_SECRET=csjmu_admin_super_secret_key_2026
ADMIN_SESSION_SECRET=csjmu_admin_session_auth_jwt_key_secure

# --- Teacher Portal Security ---
TEACHER_SECRET=csjmu_teacher_auth_secret_key_2026
TEACHER_SESSION_SECRET=csjmu_teacher_session_secure_key

# --- GitHub Cloud Backup & Sync ---
# Personal Access Token (PAT) with repo write permissions to push campus updates
GITHUB_TOKEN=
# GitHub Repository (owner/repo)
GITHUB_REPO=stark12300-hue/csjmu_nav
# Target branch
GITHUB_BRANCH=main
# Sync file paths
GITHUB_FILE_PATH=src/data/csjmuCampusData.ts
GITHUB_TEACHERS_FILE_PATH=data/teacherAccounts.json
GITHUB_BUG_REPORTS_FILE_PATH=data/bugReports.json
GITHUB_EVENTS_FILE_PATH=data/campusEvents.json

# --- Android APK Download & Updates ---
# Custom APK download URL (Leave empty to use local /csjmu_nav.apk or Google Drive/GitHub Releases link)
CUSTOM_APK_URL=

# --- Firebase & AI (Optional) ---
FIREBASE_API_KEY=
GEMINI_API_KEY=
